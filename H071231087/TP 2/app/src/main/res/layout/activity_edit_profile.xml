<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    >

    <LinearLayout
        android:id="@+id/innerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:elevation="4dp"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@color/black"
            >

            <ImageButton
                android:id="@+id/ivBack"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/back"
                android:scaleType="centerInside"
                android:background="@color/black"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Ubah Profil"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivBack"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Foto Profil dan Button Ubah Foto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_ProfilePicture"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/img"
                android:background="@drawable/circle_profile"
                android:clipToOutline="true"
                android:scaleType="centerInside"
                />

            <Button
                android:id="@+id/btn_change_photo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/iv_ProfilePicture"
                android:layout_centerHorizontal="true"
                android:background="@android:color/transparent"
                android:text="Ubah Foto Profil"
                android:textColor="@color/green_text"
                android:textStyle="bold"
                android:textSize="19sp" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Info Profil"
                android:textColor="@color/label"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/ic_info"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="5dp"
                android:src="@drawable/info"
                android:layout_gravity="center"
                />

        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:paddingHorizontal="16dp">

            <!-- Nama Label -->
            <TextView
                android:id="@+id/label_name"
                android:text="Nama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/label"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Nama Input -->
            <EditText
                android:id="@+id/et_name"
                android:layout_width="0dp"
                android:textSize="14sp"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:text="Destin Kendenan"
                android:textColor="@color/white"
                android:textColorHint="@color/hint"
                android:hint="Nama tidak boleh kosong"
                app:layout_constraintStart_toEndOf="@+id/label_name"
                app:layout_constraintBottom_toBottomOf="@id/label_name"
                android:layout_marginStart="120dp"/>

            <!-- Username Label -->
            <TextView
                android:id="@+id/label_username"
                android:text="Username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/label"
                android:textSize="14sp"
                android:layout_marginTop="30dp"
                app:layout_constraintTop_toBottomOf="@id/label_name"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- Username Input -->
            <EditText
                android:id="@+id/et_username"
                android:layout_width="0dp"
                android:textSize="14sp"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="Buat username yang unik"
                android:textColor="@color/white"
                android:textColorHint="@color/hint"
                app:layout_constraintStart_toStartOf="@id/et_name"
                app:layout_constraintBottom_toBottomOf="@id/label_username"/>

            <!-- Bio Label -->
            <TextView
                android:id="@+id/label_bio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/label"
                android:text="Bio"
                android:textSize="14sp"
                android:layout_marginTop="30dp"
                app:layout_constraintTop_toBottomOf="@id/label_username"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- Bio Input -->
            <EditText
                android:id="@+id/et_bio"
                android:layout_width="0dp"
                android:textSize="14sp"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="Tulis tentang biomu"
                android:textColor="@color/white"
                android:textColorHint="@color/hint"
                app:layout_constraintStart_toStartOf="@id/et_name"
                app:layout_constraintBottom_toBottomOf="@id/label_bio"/>

        </androidx.constraintlayout.widget.ConstraintLayout>



        <!-- Garis pemisah -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#E0E0E0"
                android:layout_marginBottom="16dp"/>

<!--    <LinearLayout-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:orientation="horizontal"-->
<!--        android:layout_marginBottom="16dp">-->

            <!-- Section Info Pribadi -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Info Pribadi"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/ic_info2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="5dp"
                android:src="@drawable/info"
                android:layout_gravity="center"
                />

        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:paddingHorizontal="16dp">

            <!-- User ID -->
            <TextView
                android:id="@+id/label_userid"
                android:text="User ID"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/label"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />

            <TextView
                android:id="@+id/tv_user_id"
                android:layout_width="0dp"
                android:textSize="14sp"
                android:text="255668168"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:textColor="#000000"
                app:layout_constraintStart_toEndOf="@+id/label_userid"
                app:layout_constraintBottom_toBottomOf="@id/label_userid"
                android:layout_marginStart="120dp"/>

            <!-- Email -->
            <TextView
                android:id="@+id/label_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/label"
                android:text="E-mail"
                android:textSize="14sp"
                android:layout_marginTop="30dp"
                app:layout_constraintTop_toBottomOf="@id/label_userid"
                app:layout_constraintStart_toStartOf="parent"/>

            <EditText
                android:id="@+id/et_email"
                android:layout_width="0dp"
                android:textSize="14sp"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="Tambah E-mail"
                android:textColor="@color/white"
                android:textColorHint="@color/hint"
                app:layout_constraintStart_toStartOf="@id/tv_user_id"
                app:layout_constraintBottom_toBottomOf="@id/label_email"/>

            <!-- Nomor HP -->
            <TextView
                android:id="@+id/label_noHP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/label"
                android:text="Nomor HP"
                android:textSize="14sp"
                android:layout_marginTop="30dp"
                app:layout_constraintTop_toBottomOf="@id/label_email"
                app:layout_constraintStart_toStartOf="parent"/>

            <EditText
                android:id="@+id/et_phone"
                android:layout_width="0dp"
                android:textSize="14sp"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:text="6456789876544"
                android:hint="Nomor HP tidak boleh kosong"
                android:textColor="@color/white"
                android:textColorHint="@color/hint"
                app:layout_constraintStart_toStartOf="@id/tv_user_id"
                app:layout_constraintBottom_toBottomOf="@id/label_noHP"/>

            <!-- Jenis Kelamin -->
            <TextView
                android:id="@+id/label_jenisKelamin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/label"
                android:text="Jenis Kelamin"
                android:textSize="14sp"
                android:layout_marginTop="30dp"
                app:layout_constraintTop_toBottomOf="@id/label_noHP"
                app:layout_constraintStart_toStartOf="parent"/>

            <EditText
                android:id="@+id/et_jenisKelamin"
                android:layout_width="0dp"
                android:textSize="14sp"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:text="Perempuan"
                android:hint="Perempuan/Laki-laki"
                android:textColor="@color/white"
                android:textColorHint="@color/hint"
                app:layout_constraintStart_toStartOf="@id/tv_user_id"
                app:layout_constraintBottom_toBottomOf="@id/label_jenisKelamin"/>

<!--            <Spinner-->
<!--                android:id="@+id/spinner_gender"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_marginBottom="16dp"-->
<!--                android:background="@drawable/edittext_background"/>-->

            <!-- Tanggal Lahir -->
            <TextView
                android:id="@+id/label_tanggalLahir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/label"
                android:text="Tanggal Lahir"
                android:textSize="14sp"
                android:layout_marginTop="30dp"
                app:layout_constraintTop_toBottomOf="@id/label_jenisKelamin"
                app:layout_constraintStart_toStartOf="parent"/>

            <EditText
                android:id="@+id/et_tanggalLahir"
                android:layout_width="0dp"
                android:textSize="14sp"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="Pilih Tanggal Lahir"
                android:textColor="@color/white"
                android:textColorHint="@color/hint"
                android:focusable="false"
                android:clickable="true"
                app:layout_constraintStart_toStartOf="@id/tv_user_id"
                app:layout_constraintBottom_toBottomOf="@id/label_tanggalLahir"/>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- Garis pemisah -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp"/>

        <!-- Tombol Tutup Akun -->
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="save"
            android:textSize="20sp"
            android:textColor="@color/green_text"
            android:background="@android:color/transparent"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>